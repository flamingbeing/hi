// Cloudflare Workers config for the family home apps on *.flamingbeing.com (HOSTING.md). The Worker
// (worker/sites.js) serves this repo's files and decides which folder each address may see (worker/routes.js).
// No data, no secrets. Workers Builds deploys it on every merge to main and posts a preview link on every PR.
{
  "name": "flamingbeing-home",
  "main": "worker/sites.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // every request goes through the Worker first (it picks the folder by address) and does the folder-index and
    // trailing-slash handling itself, so Cloudflare's own are off
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  // a preview link per branch and per build, posted on the PR by Workers Builds
  "preview_urls": true,
  "keep_vars": true,
  // required by `wrangler preview`, even when empty
  "previews": {}
}
