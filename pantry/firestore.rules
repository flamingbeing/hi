rules_version = '2';
// Family pantry. Only Google accounts listed in a household's members can read or change it.
// Deployed on merge to main by .github/workflows/deploy-firestore-rules.yml. Tests: test/run-sync.sh (local emulators).
service cloud.firestore {
  match /databases/{database}/documents {
    function email() { return request.auth.token.email.lower(); }
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    // 1 to 40 names, each a string of 1 to 40 characters. Rules have no loops, so: each one is a string (one check
    // per index), then the names joined with newlines (none may hold one) fit one pattern of 1 to 40 characters each.
    function placeNames(l) {
      let n = l.size();
      return n >= 1 && n <= 40
        && (n <= 0 || l[0] is string) && (n <= 1 || l[1] is string) && (n <= 2 || l[2] is string) && (n <= 3 || l[3] is string) && (n <= 4 || l[4] is string)
        && (n <= 5 || l[5] is string) && (n <= 6 || l[6] is string) && (n <= 7 || l[7] is string) && (n <= 8 || l[8] is string) && (n <= 9 || l[9] is string)
        && (n <= 10 || l[10] is string) && (n <= 11 || l[11] is string) && (n <= 12 || l[12] is string) && (n <= 13 || l[13] is string) && (n <= 14 || l[14] is string)
        && (n <= 15 || l[15] is string) && (n <= 16 || l[16] is string) && (n <= 17 || l[17] is string) && (n <= 18 || l[18] is string) && (n <= 19 || l[19] is string)
        && (n <= 20 || l[20] is string) && (n <= 21 || l[21] is string) && (n <= 22 || l[22] is string) && (n <= 23 || l[23] is string) && (n <= 24 || l[24] is string)
        && (n <= 25 || l[25] is string) && (n <= 26 || l[26] is string) && (n <= 27 || l[27] is string) && (n <= 28 || l[28] is string) && (n <= 29 || l[29] is string)
        && (n <= 30 || l[30] is string) && (n <= 31 || l[31] is string) && (n <= 32 || l[32] is string) && (n <= 33 || l[33] is string) && (n <= 34 || l[34] is string)
        && (n <= 35 || l[35] is string) && (n <= 36 || l[36] is string) && (n <= 37 || l[37] is string) && (n <= 38 || l[38] is string) && (n <= 39 || l[39] is string)
        && !l.join('').matches('[\\s\\S]*\\n[\\s\\S]*')
        && l.join('\n').matches('[^\\n]{1,40}(\\n[^\\n]{1,40}){0,39}');
    }
    // Names for the family (settings/people): at most 20, each a string of 1 to 40 characters on one line, keyed by an
    // email (no spaces, one @). The same trick as placeNames: a string check per index, then one pattern over the
    // values joined with newlines (none may hold one), and one over the keys. An empty map is fine (no names given).
    function peopleNames(m) {
      let v = m.values();
      let n = v.size();
      return n <= 20
        && (n == 0 || (
          (n <= 0 || v[0] is string) && (n <= 1 || v[1] is string) && (n <= 2 || v[2] is string) && (n <= 3 || v[3] is string) && (n <= 4 || v[4] is string)
          && (n <= 5 || v[5] is string) && (n <= 6 || v[6] is string) && (n <= 7 || v[7] is string) && (n <= 8 || v[8] is string) && (n <= 9 || v[9] is string)
          && (n <= 10 || v[10] is string) && (n <= 11 || v[11] is string) && (n <= 12 || v[12] is string) && (n <= 13 || v[13] is string) && (n <= 14 || v[14] is string)
          && (n <= 15 || v[15] is string) && (n <= 16 || v[16] is string) && (n <= 17 || v[17] is string) && (n <= 18 || v[18] is string) && (n <= 19 || v[19] is string)
          && !v.join('').matches('[\\s\\S]*\\n[\\s\\S]*')
          && v.join('\n').matches('[^\\n]{1,40}(\\n[^\\n]{1,40}){0,19}')
          && m.keys().join('\n').matches('[^\\s@]+@[^\\s@]+(\\n[^\\s@]+@[^\\s@]+){0,19}')));
    }
    // Stock (16 Oct 2026). An item's `batches` is the old ARRAY (at most 60) or the new MAP `{ <batchId>: { qty, expiry, ... } }`.
    // Both are accepted while phones update; anything else is refused. A map holds at most 60 batches, and EVERY id is 1 to
    // 40 letters, digits, - or _ (one pattern over the ids joined with newlines: the placeNames trick). Each of the first 12
    // batches is also checked: qty a number from -99 to 9999 (the low end exists because two phones can each use the last
    // unit: the server adds both, the app shows 0), expiry a string or empty. Only the first 12, because the rules'
    // 1000-expression limit is spent by about 16 such checks (tested: 60 batches pass with 12); the app clamps any
    // quantity it reads, so a bad one further along can't break a screen.
    function batchOk(b) {
      let q = b.get('qty', 0);
      let x = b.get('expiry', null);
      return q is number && q >= -99 && q <= 9999 && (x == null || x is string);
    }
    function batchValues(v, n) {
      return n == 0 || (
          (n <= 0 || batchOk(v[0])) && (n <= 1 || batchOk(v[1])) && (n <= 2 || batchOk(v[2])) && (n <= 3 || batchOk(v[3]))
          && (n <= 4 || batchOk(v[4])) && (n <= 5 || batchOk(v[5])) && (n <= 6 || batchOk(v[6])) && (n <= 7 || batchOk(v[7]))
          && (n <= 8 || batchOk(v[8])) && (n <= 9 || batchOk(v[9])) && (n <= 10 || batchOk(v[10])) && (n <= 11 || batchOk(v[11])));
    }
    function batchMap(m) {
      return m.size() <= 60
        && batchValues(m.values(), m.size())
        && (m.size() == 0 || m.keys().join('\n').matches('[A-Za-z0-9_-]{1,40}(\\n[A-Za-z0-9_-]{1,40}){0,59}'));
    }
    function stockOk(d) {
      let b = d.get('batches', []);
      return b is list ? b.size() <= 60 : (b is map && batchMap(b));
    }
    function member(hid) {
      return signedIn() && email() in get(/databases/$(database)/documents/households/$(hid)).data.members;
    }

    match /households/{hid} {
      allow read: if signedIn() && email() in resource.data.members;
      // start a household: you are its owner and only member
      allow create: if signedIn()
        && request.resource.data.owner == email()
        && request.resource.data.members == [email()]
        && request.resource.data.keys().hasOnly(['name', 'owner', 'members', 'createdAt']);
      // members may add or remove family, rename it; the owner stays and stays a member
      allow update: if signedIn() && email() in resource.data.members
        && request.resource.data.owner == resource.data.owner
        && resource.data.owner in request.resource.data.members
        && request.resource.data.members is list && request.resource.data.members.size() <= 20
        && request.resource.data.keys().hasOnly(['name', 'owner', 'members', 'createdAt']);
      allow delete: if signedIn() && email() == resource.data.owner;

      // reading and deleting: every kind; writing items, photos and settings has limits (below)
      match /{kind}/{id} {
        allow read, delete: if kind in ['items', 'events', 'shop', 'photos', 'settings'] && member(hid);
        allow create, update: if kind == 'shop' && member(hid);
      }
      // History is write-once (16 Oct 2026): a line is created, and may be deleted (Undo, deleting an item, merging);
      // nothing edits one. Writing a line again exactly as it is (restoring a backup, re-running a merge) is allowed.
      match /events/{id} {
        allow create: if member(hid);
        allow update: if member(hid) && request.resource.data == resource.data;
      }
      // An item carries only a small thumbnail (`thumb`, at most 12 KB); its photo is in photos/{id}. Items from
      // before 16 Oct 2026 may still hold a whole photo as `photo`: it may stay as it was or be removed (moved to
      // photos/{id}), but no item may gain or change one (an empty `photo`, from older app versions, is fine).
      match /items/{id} {
        allow create, update: if member(hid)
          && stockOk(request.resource.data)
          && request.resource.data.get('thumb', '') is string
          && request.resource.data.get('thumb', '').size() <= 12288
          && (request.resource.data.get('photo', '') == ''
            || (resource != null && request.resource.data.photo == resource.data.get('photo', null)));
      }
      // Shared settings, one document each (no others): the family's list of places (16 Oct 2026), settings/places =
      // { id, list, updatedAt }, the list 1 to 40 names of 1 to 40 characters; and the names members give each other
      // (16 Oct 2026), settings/people = { id, names: { email: name }, updatedAt }, exactly those three fields.
      match /settings/{id} {
        allow create, update: if member(hid) && (
          (id == 'places'
            && request.resource.data.keys().hasOnly(['id', 'list', 'updatedAt'])
            && request.resource.data.id == 'places'
            && request.resource.data.list is list
            && placeNames(request.resource.data.list))
          || (id == 'people'
            && request.resource.data.keys().hasAll(['id', 'names', 'updatedAt'])
            && request.resource.data.keys().hasOnly(['id', 'names', 'updatedAt'])
            && request.resource.data.id == 'people'
            && request.resource.data.updatedAt is string
            && request.resource.data.names is map
            && peopleNames(request.resource.data.names)));
      }
      // One photo per item (same id), at most 150 KB, read only when the item is opened.
      match /photos/{id} {
        allow create, update: if member(hid)
          && request.resource.data.keys().hasOnly(['id', 'data', 'updatedAt'])
          && request.resource.data.data is string
          && request.resource.data.data.size() <= 153600;
      }
    }
  }
}
